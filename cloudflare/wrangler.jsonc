// Przekaźnik api.makietka.app i aplikacja makietka.app (#352) – jeden worker, Cloudflare Workers Builds (integracja z GitHubem).
// Ustawienia budowania: katalog główny „cloudflare”, polecenie wdrożenia „npx wrangler deploy”.
// Worker przekazuje zapytania do bazy, obsługuje pliki w R2 (api-worker.js) i pocztę (poczta.js).
// Bucket R2 „makietka-files” trzeba raz utworzyć w panelu Cloudflare (docs/KONFIGURACJA-DOMENY.md, „Pliki w R2”).
// Sekrety (panel Workera): SUPABASE_SERVICE_ROLE_KEY, opcjonalnie TURNSTILE_SECRET i FORWARD_TO – poczta (poczta.js, #95, #106).
{
  "name": "makietka-api",
  "main": "api-worker.js",
  "compatibility_date": "2025-10-01",
  // @cloudflare/puppeteer (rysowanie na serwerze, #335) potrzebuje zgodności z Node.
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "api.makietka.app", "custom_domain": true },
    // Aplikacja makietka.app (#352) – ten sam worker podaje pliki strony; www przekierowuje na makietka.app.
    // Rekordy DNS (proxied AAAA 100::) – cloudflare/aplikacja/dns-makietka-app.txt.
    { "pattern": "makietka.app/*", "zone_name": "makietka.app" },
    { "pattern": "www.makietka.app/*", "zone_name": "makietka.app" }
  ],
  // Pliki aplikacji budowane przy każdym wdrożeniu (scripts/buduj-strone.sh → ../_site).
  "build": { "command": "bash ../scripts/buduj-strone.sh _site" },
  "assets": {
    "directory": "../_site",
    "binding": "ASSETS",
    // Krótkie linki podglądu (makietka.app/<kod>) i adresy bez pliku – 404.html, czyli ta sama aplikacja.
    "not_found_handling": "404-page",
    // Najpierw kod: api.makietka.app to przekaźnik, makietka.app – pliki (api-worker.js, początek fetch).
    "run_worker_first": true
  },
  "workers_dev": false,
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "PLIKI", "bucket_name": "makietka-files" }],
  // Rysowanie stron linku na serwerze (#335, cloudflare/rysowanie.js): przeglądarka Cloudflare i kolejka na projekt.
  "browser": { "binding": "PRZEGLADARKA" },
  "durable_objects": { "bindings": [{ "name": "RYSOWANIE", "class_name": "Rysowanie" }] },
  "migrations": [{ "tag": "rysowanie-v1", "new_sqlite_classes": ["Rysowanie"] }],
  "vars": {
    "SUPABASE_URL": "https://pganajmivwtstapnwsgv.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_gt_GEmBz6SfJZ0o9rAhLQA_HKH0V_cq",
    "APLIKACJA": "https://makietka.app"
  },
  // Podglądy gałęzi (Workers Builds „npx wrangler preview”, #354): te same publiczne adresy i ten sam magazyn plików
  // (dostęp i tak sprawdza logowanie); bez crona i Durable Objects (podgląd ich nie dostaje) – rysowanie na serwerze
  // w podglądzie nie działa, działa na produkcji.
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://pganajmivwtstapnwsgv.supabase.co",
      "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_gt_GEmBz6SfJZ0o9rAhLQA_HKH0V_cq",
      "APLIKACJA": "https://makietka.app"
    },
    "r2_buckets": [{ "binding": "PLIKI", "bucket_name": "makietka-files" }],
    "browser": { "binding": "PRZEGLADARKA" }
  },
  // Co minutę przebieg kolejki maili (cloudflare/poczta.js, decyzja #95).
  "triggers": { "crons": ["* * * * *"] }
}
