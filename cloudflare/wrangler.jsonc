// Przekaźnik api.makietka.app dla Cloudflare Workers Builds (integracja z GitHubem).
// Ustawienia budowania: katalog główny „cloudflare”, polecenie wdrożenia „npx wrangler deploy”.
// Worker przekazuje zapytania do bazy, obsługuje pliki w R2 (api-worker.js) i pocztę (poczta.js).
// Bucket R2 „makietka-files” trzeba raz utworzyć w panelu Cloudflare (docs/KONFIGURACJA-DOMENY.md, „Pliki w R2”).
// Sekrety (panel Workera): SUPABASE_SERVICE_ROLE_KEY, opcjonalnie TURNSTILE_SECRET i FORWARD_TO – poczta (poczta.js, #95, #106).
{
  "name": "makietka-api",
  "main": "api-worker.js",
  "compatibility_date": "2025-10-01",
  "routes": [{ "pattern": "api.makietka.app", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "PLIKI", "bucket_name": "makietka-files" }],
  "vars": {
    "SUPABASE_URL": "https://pganajmivwtstapnwsgv.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_gt_GEmBz6SfJZ0o9rAhLQA_HKH0V_cq"
  },
  // Co minutę przebieg kolejki maili (cloudflare/poczta.js, decyzja #95).
  "triggers": { "crons": ["* * * * *"] }
}
