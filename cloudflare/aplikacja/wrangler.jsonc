// Aplikacja makietka.app na Cloudflare (#345, #347) – pliki strony (static assets) i krótki kod przekierowania www.
// Workers Builds (integracja z GitHubem): katalog główny „/”, polecenie budowania „bash scripts/buduj-strone.sh”,
// polecenie wdrożenia „npx wrangler deploy -c cloudflare/aplikacja/wrangler.jsonc”. Kroki w panelu:
// cloudflare/README.md, „Aplikacja na Cloudflare”.
// Domena: trasy makietka.app/* i www.makietka.app/* w strefie makietka.app. Rekordy DNS (proxied AAAA 100::)
// – import z pliku cloudflare/aplikacja/dns-makietka-app.txt.
{
  "name": "makietka-app",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "makietka.app/*", "zone_name": "makietka.app" },
    { "pattern": "www.makietka.app/*", "zone_name": "makietka.app" }
  ],
  "assets": {
    "directory": "../../_site",
    "binding": "ASSETS",
    // Krótkie linki podglądu (makietka.app/<kod>) i adresy bez pliku – 404.html, czyli ta sama aplikacja.
    "not_found_handling": "404-page",
    // Kod najpierw tylko po to, żeby www przekierować także dla istniejących plików.
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
